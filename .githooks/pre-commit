#!/usr/bin/env bash
set -euo pipefail

echo "[pre-commit] Checking cargo fmt..."
cargo fmt --all -- --check

echo "[pre-commit] Running cargo clippy..."
cargo clippy --all-targets --all-features --locked -- -D warnings 2>&1

echo "[pre-commit] Running cargo test..."
cargo test --all-targets --all-features --locked 2>&1

echo "[pre-commit] OK"
